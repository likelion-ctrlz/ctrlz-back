# DB (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET_KEY=여기에_랜덤_시크릿_키_입력
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-northeast-2
