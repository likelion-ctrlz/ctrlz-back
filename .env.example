# DB (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-northeast-2

# 공공데이터포털 - 서울특별시교육청 평생학습포털 에버러닝 강좌정보 서비스
EVERLEARNING_API_KEY=
# 활용신청 상세페이지의 "요청 URL 예제"에서 오퍼레이션명 확인 후 필요시 교체 (기본값: getLctreInfo)
EVERLEARNING_OPERATION=getLectureList
